@using System.Globalization
@using Bolsines.Controlador
@using Bolsines.Entidades
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@page "/seguimiento"

<PageTitle>Seguimiento de Bolsines</PageTitle>

@if (estaHabilitada)
{
    <div class="seg">
        <div class="seg-cab">
            <div>
                <h1 class="b-titulo">Seguimiento de bolsines</h1>
                <p class="b-bajada">Comisión médica: <b>@txtCMUsuario</b></p>
            </div>
            <button class="b-btn b-btn-borde seg-cancelar" @onclick="cancelarCU">Cancelar</button>
        </div>

        <div class="seg-grid">
            <div class="b-caja seg-panel">
                @if (sinBolsinesEnviados)
                {
                    @* A1: no se encuentran bolsines en estado enviado *@
                    <div class="seg-vacio">
                        <b>No se encontraron bolsines enviados</b>
                        No hay bolsines en estado Enviado cuya comisión médica de origen sea
                        @(txtCMUsuario).
                    </div>
                    <div class="seg-bloque">
                        <div class="b-fila-btn">
                            <button class="b-btn b-btn-azul" @onclick="cancelarCU">Volver al inicio</button>
                        </div>
                    </div>
                }
                else
                {
                    @* Paso 6: filtrar por número de precinto o CM destino *@
                    <div class="seg-bloque">
                        <h3 class="seg-subtit">Filtrar</h3>
                        <div class="b-campo">
                            <label for="f-precinto">Número de precinto</label>
                            <input id="f-precinto" placeholder="Ej. 1437" @bind="filtroPrecinto"
                                   @bind:event="oninput" @onkeydown="TeclaFiltro" />
                        </div>
                        <div class="b-campo">
                            <label for="f-destino">Comisión médica destino</label>
                            <select id="f-destino" @bind="filtroCMDestino">
                                <option value="">Todas</option>
                                @foreach (var cm in opcionesCMDestino)
                                {
                                    <option value="@cm.codigo">@(cm.nombre) (@(cm.codigo))</option>
                                }
                            </select>
                        </div>
                        <div class="b-fila-btn">
                            <button class="b-btn b-btn-texto" @onclick="LimpiarFiltro">Limpiar</button>
                            <button class="b-btn b-btn-borde" @onclick="AplicarFiltro">Filtrar</button>
                        </div>
                        @if (mensajeFiltro is not null)
                        {
                            @* A2: no se encuentra bolsín con el número de precinto ingresado *@
                            <div class="b-aviso seg-msj">@mensajeFiltro</div>
                        }
                    </div>

                    @if (bolsinesSinUbicacion.Count > 0)
                    {
                        @* A3: el GPS Tracker no pudo informar la ubicación *@
                        <div class="seg-bloque">
                            <div class="b-aviso">
                                @if (bolsinesSinUbicacion.Count == 1)
                                {
                                    <text>El GPS Tracker no pudo informar la ubicación del bolsín <b>@(bolsinesSinUbicacion[0])</b>.</text>
                                }
                                else
                                {
                                    <text>El GPS Tracker no pudo informar la ubicación de los bolsines <b>@(string.Join(", ", bolsinesSinUbicacion))</b>.</text>
                                }
                            </div>
                        </div>
                    }

                    @if (btnConfirmarEnvioMail)
                    {
                        <div class="seg-bloque">
                            <h3 class="seg-subtit">Bolsín seleccionado</h3>
                            <dl class="seg-resumen">
                                <dt>Número</dt><dd>@selNumero</dd>
                                <dt>Última actualización</dt><dd>@FechaSeleccionado()</dd>
                                <dt>Coordenadas</dt><dd>@Coordenadas()</dd>
                            </dl>
                            @* Paso 8: el sistema consulta si se desea enviar el correo *@
                            <div class="seg-pregunta">
                                ¿Desea enviar un correo electrónico al Gerente de la comisión médica de destino para
                                informar la ubicación del bolsín?
                                <div class="b-fila-btn">
                                    <button class="b-btn b-btn-texto" @onclick="NoEnviarCorreo">No enviar</button>
                                    <button class="b-btn b-btn-azul" @onclick="tomarConfirmacion" disabled="@enviando">Enviar correo</button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="seg-bloque">
                            <p class="seg-ayuda">
                                @if (correoNoEnviado is not null)
                                {
                                    <text>No se envió el correo del bolsín @(correoNoEnviado). </text>
                                }
                                Seleccioná un bolsín en el mapa para informar su ubicación.
                            </p>
                        </div>
                    }
                }
            </div>

            <div class="b-caja seg-mapa">
                <div @ref="mapBolsinesEnviados" id="map"></div>
            </div>
        </div>
    </div>

    @if (mostrarMensajeNotificacion)
    {
        <div class="b-velo">
            <div class="b-ventana">
                <div class="b-ventana-tope"></div>
                <div class="b-ventana-cuerpo">
                    <h2><span class="b-tilde">✓</span>Ubicación notificada</h2>
                    <p>
                        Se envió un correo al Gerente de la comisión médica de destino (@(emailNotificado)) con la
                        ubicación del bolsín.
                    </p>
                    <dl>
                        <dt>Número de bolsín</dt><dd>@selNumero</dd>
                        <dt>Última actualización</dt><dd>@FechaSeleccionado()</dd>
                        <dt>Coordenadas</dt><dd>@Coordenadas()</dd>
                    </dl>
                </div>
                <div class="b-ventana-botones">
                    <button class="b-btn b-btn-azul" @onclick="CerrarVentanaInformacion">Aceptar</button>
                </div>
            </div>
        </div>
    }
}

@code {
    // Atributos del componente
    private IJSObjectReference? moduloJS;
    private DotNetObjectReference<PantallaSeguimiento>? referenciaNet;
    private bool estaHabilitada = false;
    private bool mapaEstaCargado = false;
    private bool mapaDesactualizado = false;
    private bool enviando = false;

    // Datos de la pantalla
    private string txtCMUsuario = "";
    private ElementReference mapBolsinesEnviados;
    // Localización de los bolsines del mapa (String[][]: número, latitud, longitud, fecha y hora)
    private string[][] cmbBolsinesMapa = new string[0][];
    private List<(string codigo, string nombre)> opcionesCMDestino = new();
    private List<int> bolsinesSinUbicacion = new();
    private bool sinBolsinesEnviados = false;
    private string filtroPrecinto = "";
    private string filtroCMDestino = "";
    private string? mensajeFiltro;
    private bool btnConfirmarEnvioMail = false;
    private int? correoNoEnviado;
    private int selNumero;
    private bool mostrarMensajeNotificacion = false;
    private string emailNotificado = "";
    private ControladorSeguimiento controladorSeguimiento = default!;

    // Métodos del componente
    protected override void OnInitialized()
    {
        this.opcionConsultarUbicacionBolsines();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!estaHabilitada)
        {
            return;
        }

        if (!mapaEstaCargado)
        {
            mapaEstaCargado = true;
            mapaDesactualizado = false;
            referenciaNet = DotNetObjectReference.Create(this);
            moduloJS = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./mapaLeaflet.js");
            await moduloJS.InvokeAsync<string>("cargarMapa", LeerLocalizaciones(), referenciaNet);
        }
        else if (mapaDesactualizado && moduloJS is not null)
        {
            mapaDesactualizado = false;
            await moduloJS.InvokeVoidAsync("actualizarMarcadores", LeerLocalizaciones());
        }

        if (moduloJS is not null)
        {
            await moduloJS.InvokeVoidAsync("resaltarBolsin", btnConfirmarEnvioMail ? selNumero : 0);
        }
    }

    // Lee el GeoJSON que genera ServidorGoogleMaps (misma ruta relativa que usa para escribirlo)
    private string LeerLocalizaciones()
    {
        string ruta = Path.Combine("wwwroot", "localizaciones.json");
        return File.Exists(ruta) ? File.ReadAllText(ruta) : "[]";
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (moduloJS is not null)
        {
            try
            {
                await moduloJS.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // La comunicación entre el navegador y el módulo JS ya no existe.
            }
        }
        referenciaNet?.Dispose();
    }

    // Paso 7: el EB selecciona un bolsín del mapa (lo llama mapaLeaflet.js al hacer clic)
    [JSInvokable]
    public void SeleccionarBolsinDesdeMapa(int numeroSeleccionado)
    {
        bool estaEnElMapa = this.cmbBolsinesMapa.Any(localizacion =>
            localizacion[0] == numeroSeleccionado.ToString(CultureInfo.InvariantCulture)
        );

        if (estaEnElMapa && !mostrarMensajeNotificacion)
        {
            this.tomarSeleccionBolsin(numeroSeleccionado);
            StateHasChanged();
        }
    }

    private void AplicarFiltro()
    {
        int? precinto = null;
        mensajeFiltro = null;

        if (!string.IsNullOrWhiteSpace(filtroPrecinto))
        {
            if (int.TryParse(filtroPrecinto.Trim(), out int numero))
            {
                precinto = numero;
            }
            else
            {
                mensajeFiltro = "Ingresá un número de precinto válido.";
                return;
            }
        }

        this.tomarFiltro(precinto, string.IsNullOrEmpty(filtroCMDestino) ? null : filtroCMDestino);
    }

    private void LimpiarFiltro()
    {
        filtroPrecinto = "";
        filtroCMDestino = "";
        this.AplicarFiltro();
    }

    private void TeclaFiltro(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            this.AplicarFiltro();
        }
    }

    private void NoEnviarCorreo()
    {
        this.controladorSeguimiento.tomarNoEnvioCorreo();
    }

    private void CerrarVentanaInformacion()
    {
        this.mostrarMensajeNotificacion = false;
        this.controladorSeguimiento.ConfirmacionAceptada();
    }

    private void cancelarCU()
    {
        this.controladorSeguimiento.cancelarCU();
    }

    // Datos del bolsín seleccionado, tomados de la localización que muestra el mapa
    // (String[][]: [0] número, [1] latitud, [2] longitud, [3] fecha y hora)
    private string[] LocalizacionSeleccionada()
    {
        string numero = selNumero.ToString(CultureInfo.InvariantCulture);
        return this.cmbBolsinesMapa.FirstOrDefault(localizacion => localizacion[0] == numero)
            ?? new string[] { numero, "0", "0", "" };
    }

    private string Coordenadas()
    {
        string[] localizacion = this.LocalizacionSeleccionada();
        double latitud = double.Parse(localizacion[1], CultureInfo.InvariantCulture);
        double longitud = double.Parse(localizacion[2], CultureInfo.InvariantCulture);
        return latitud.ToString("0.0000", CultureInfo.InvariantCulture) + ", "
            + longitud.ToString("0.0000", CultureInfo.InvariantCulture);
    }

    private string FechaSeleccionado()
    {
        string fecha = this.LocalizacionSeleccionada()[3];
        return fecha == ""
            ? ""
            : DateTime.Parse(fecha, CultureInfo.InvariantCulture).ToString("dd/MM/yyyy HH:mm");
    }

    // Métodos (mensajes del diagrama de secuencia)
    public void opcionConsultarUbicacionBolsines()
    {
        this.habilitarPantalla();
        this.controladorSeguimiento = new ControladorSeguimiento(this, NavigationManager);
        this.controladorSeguimiento.nuevoSeguimientoBolsines();
    }

    public void habilitarPantalla()
    {
        this.estaHabilitada = true;
    }

    public void mostrarCMUsuarioLogueado(string nombreCM, string codigoCM)
    {
        this.txtCMUsuario = $"{nombreCM} ({codigoCM})";
    }

    // A1
    public void informarNoHayBolsinesEnviados()
    {
        this.sinBolsinesEnviados = true;
    }

    // A3
    public void informarBolsinesSinUbicacion(List<int> numerosBolsines)
    {
        this.bolsinesSinUbicacion = numerosBolsines;
    }

    public void mostrarOpcionesFiltroCMDestino(List<(string codigo, string nombre)> opciones)
    {
        this.opcionesCMDestino = opciones;
    }

    public void pedirSeleccionBolsin(string[][] localizacionBolsines)
    {
        this.cmbBolsinesMapa = localizacionBolsines;
        this.mapaDesactualizado = true;
    }

    public void tomarFiltro(int? numeroPrecinto, string? codigoCMDestino)
    {
        this.btnConfirmarEnvioMail = false;
        this.correoNoEnviado = null;
        this.controladorSeguimiento.tomarFiltro(numeroPrecinto, codigoCMDestino);
    }

    // A2
    public void informarPrecintoNoEncontrado(int numeroPrecinto)
    {
        this.mensajeFiltro = $"No se encontró ningún bolsín con el número de precinto {numeroPrecinto}.";
    }

    public void tomarSeleccionBolsin(int numeroBolsin)
    {
        this.selNumero = numeroBolsin;
        this.correoNoEnviado = null;
        this.controladorSeguimiento.tomarSeleccionBolsin(numeroBolsin);
    }

    // Habilita el botón para enviar el mail al gerente de la CM destino
    public void solicitarConfirmacionEnvioMail()
    {
        this.btnConfirmarEnvioMail = true;
    }

    // A5
    public void informarCorreoNoEnviado(int numeroBolsin)
    {
        this.correoNoEnviado = numeroBolsin;
        this.btnConfirmarEnvioMail = false;
    }

    public async Task tomarConfirmacion()
    {
        this.enviando = true;
        await this.controladorSeguimiento.tomarConfirmacion();
    }

    public void informarEnvioMail(string emailGCMDestino)
    {
        this.emailNotificado = emailGCMDestino;
        this.mostrarMensajeNotificacion = true;
    }
}
