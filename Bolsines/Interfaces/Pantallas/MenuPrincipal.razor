@using Bolsines.Persistencia
@using Bolsines.Entidades
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@page "/"

<PageTitle>Menú Principal</PageTitle>

<div class="bol-pagina">
    <h1 class="b-titulo">Hola, @nombreEmpleadoLogueado</h1>
    <p class="b-bajada">¿Qué querés hacer hoy?</p>

    @* Paso 1: el EB selecciona la opción para consultar la ubicación de bolsines *@
    <div class="b-caja ini-opcion">
        <div class="ini-icono">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="color: #31609B;" />
        </div>
        <div>
            <h2>Consultar seguimiento de bolsines</h2>
            <p>Ver en un mapa la ubicación de los bolsines enviados desde tu comisión médica.</p>
            <a class="b-btn b-btn-azul" href="seguimiento">Consultar ubicación</a>
        </div>
    </div>
</div>

@code {
    private string nombreEmpleadoLogueado = "";

    protected override void OnInitialized()
    {
        // Una sola instancia del repositorio para ambas consultas
        var repositorio = new RepositorioBolsines();
        var empleados = repositorio.cargarEmpleados();
        var sesionActual = repositorio.cargarSesionActual();
        var usuarioLogueado = sesionActual.getUsuario();

        foreach (Empleado empleado in empleados)
        {
            if (empleado.esTuUsuario(usuarioLogueado))
            {
                this.nombreEmpleadoLogueado = empleado.getNombre();
                break;
            }
        }
    }
}
